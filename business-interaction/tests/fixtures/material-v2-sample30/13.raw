<script src="/js/dayjs.js"></script>
<script>
    // メニュー取得・カート件数・ログイン状態表示。
    // fetch と DOM 操作は vanilla JS で実装し、jQuery 未読込環境でも動作させる
    (function() {
        const initHeader = () => {
            const badge = document.getElementById('badgeCount');
            if (badge) {
                badge.style.display = 'none';
            }

            // 作品を探す
            fetch('https://amnibus.com/artwork_titles', {
                method: 'GET'
            }).then(response => {
                if (!response.ok) {
                    return response.json().then(err => Promise.reject(err))
                }
                return response.json()
            }).then(data => {
                const list = document.getElementById('artwork_title-list');
                if (!list) {
                    return;
                }
                data.forEach((item) => {
                    list.insertAdjacentHTML(
                        'beforeend',
                        `<li><a href="https://amnibus.com/products/title/${item.selfAndChildIds}">${item.title}</a></li>`
                    )
                })
            }).catch(e => {
                console.error('Artwork titles API request failed:', e);
            })

            // 種類で探す
            fetch('https://amnibus.com/recent_categories', {
                method: 'GET'
            }).then(response => {
                if (!response.ok) {
                    return response.json().then(err => Promise.reject(err))
                }
                return response.json()
            }).then(data => {
                const list = document.getElementById('category-list');
                if (!list) {
                    return;
                }
                data.forEach((item) => {
                    list.insertAdjacentHTML(
                        'beforeend',
                        `<li><a href="https://amnibus.com/products/list?categoryId=${item.id}">${item.name}</a></li>`
                    )
                });
            }).catch(e => {
                console.error('Recent categories API request failed:', e);
            });

            // カート件数
            fetch('/cart/count', {
                method: 'GET'
            }).then(response => {
                if (!response.ok) {
                    return response.json().then(err => Promise.reject(err))
                }
                return response.json()
            }).then(data => {
                const count = data.count
                if (count > 0 && badge) {
                    badge.textContent = count;
                    badge.style.opacity = '0';
                    badge.style.display = '';
                    requestAnimationFrame(() => {
                        badge.style.transition = 'opacity 1s';
                        badge.style.opacity = '1';
                    });
                }
            }).catch(error => {
                console.error(error);
            });

            // ログインチェック
            fetch('/mypage/check', {
                method: 'GET'
            }).then(response => {
                if (!response.ok) {
                    return response.json().then(err => Promise.reject(err))
                }
                return response.json()
            }).then(data => {
                const mypage = document.getElementById('header-mypage');
                const login = document.getElementById('header-login');
                const container = document.getElementById('header-login-container');
                if (data.check) {
                    document.querySelectorAll('.header__menu--register').forEach(el => {
                        el.style.display = 'none';
                    });
                    if (mypage) {
                        mypage.style.display = '';
                    }
                    if (login) {
                        login.style.display = 'none';
                    }
                } else {
                    document.querySelectorAll('.header__menu--logout').forEach(el => {
                        el.style.display = 'none';
                    });
                    if (mypage) {
                        mypage.style.display = 'none';
                    }
                    if (login) {
                        login.style.display = '';
                    }
                }
                if (container) {
                    container.style.display = '';
                }
            }).catch(error => {
                console.error(error);
            })
        };

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initHeader);
        } else {
            initHeader();
        }
    })();

    // 検索窓: 入力の有無で消去ボタンの表示と検索ボタンの活性を切り替える
    (function() {
        const container = document.getElementById('header-search-container');
        const input = document.getElementById('search_words');
        const clear = document.getElementById('header-search-clear');
        const submit = document.getElementById('header-search-submit');
        if (!container || !input || !clear || !submit) {
            return;
        }

        const sync = () => {
            const filled = input.value !== '';
            container.classList.toggle('is-filled', filled);
            submit.disabled = !filled;
        };

        input.addEventListener('input', sync);
        clear.addEventListener('click', () => {
            input.value = '';
            sync();
            input.focus();
        });
        // 戻る/進むでブラウザが入力途中の値を復元するため、表示中ページの検索語に戻す
        window.addEventListener('pageshow', (event) => {
            const navigation = performance.getEntriesByType('navigation')[0];
            if (event.persisted || navigation?.type === 'back_forward') {
                input.value = input.defaultValue;
            }
            sync();
        });
        sync();
    })();

    // ハンバーガーメニュー開閉
    // jQuery が読み込まれていない環境ではガードして以降をスキップ
    (function() {
        if (typeof $ === 'undefined') {
            const message = '[header] jQuery 未読込のためハンバーガーメニュー操作を無効化しました';
            console.warn(message);
            if (typeof Sentry !== 'undefined') {
                Sentry.captureMessage(message, 'warning');
            }
            return;
        }

        $(function() {
            $('.header__menuContainer').on('click', function(event) {
                event.stopPropagation();
                $(this).toggleClass('header__menu--active');
            });

            // メニュー”以外”がクリックされたときも.header__menu--activeを外す
            $(document).on('click', function(event) {
                if (!$(event.target).closest('.header__menu').length) {
                    $('.header__menuContainer').removeClass('header__menu--active');
                }
            });

            $('.header__menu').on('click', function(event) {
                event.stopPropagation();
            });
        });
    })();
</script>
    
