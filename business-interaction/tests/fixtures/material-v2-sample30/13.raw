    <script>
    (function () {
        function makeShim() {
            let store = Object.create(null);
            return {
                getItem: function (k) {
                    k = String(k);
                    return Object.prototype.hasOwnProperty.call(store, k) ? store[k] : null;
                },
                setItem: function (k, v) { store[String(k)] = String(v); },
                removeItem: function (k) { delete store[String(k)]; },
                clear: function () { store = Object.create(null); },
                key: function (i) {
                    const keys = Object.keys(store);
                    return (i >= 0 && i < keys.length) ? keys[i] : null;
                },
                get length() { return Object.keys(store).length; }
            };
        }

        // 戻り値 'ok': 正常に使える / 'shimmed': shim を注入した / 'failed': 壊れているが注入にも失敗
        function ensure(name) {
            try {
                const s = window[name];
                if (s != null) {
                    s.getItem('__storage_probe__');
                    return 'ok';
                }
            } catch (e) {}
            try {
                Object.defineProperty(window, name, { value: makeShim(), writable: true, configurable: true });
                return 'shimmed';
            } catch (e) {
                return 'failed';
            }
        }

        const results = [ensure('localStorage'), ensure('sessionStorage')];
        if (results.indexOf('shimmed') !== -1) { window.__storageShimmed = true; }
        if (results.indexOf('failed') !== -1) { window.__storageShimFailed = true; }
    })();
</script>

    
