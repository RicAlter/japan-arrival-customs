    <!-- Google Tag Manager -->
    <script>
        window.dataLayer = window.dataLayer || [];

        // A/Bテストの振り分け
        // パターンA/パターンBを50/50で割り当て、localStorageで固定
        // 割り当てたvariantはdataLayerにpushし、GA4でvariant別に計測できるようにする
        // パターンBのときは描画前に html.ab-variant-bを付与
        // 出し分けたい要素に.patternA/.patternBを用意し、CSS 側でhtml.ab-variant-bを基準に表示を切り替える
        // localStorageが使えない環境（localstorage-guardのshim含む）は割り当てを固定できないためパターンAにする
        (function () {
            function assignVariant() {
                if (window.__storageShimmed || window.__storageShimFailed) {
                    return 'A';
                }
                var stored = localStorage.getItem('ab_productlist_variant');
                if (stored === 'A' || stored === 'B') {
                    return stored;
                }
                var picked = Math.random() < 0.5 ? 'A' : 'B';
                localStorage.setItem('ab_productlist_variant', picked);
                return picked;
            }

            var variant;
            try {
                variant = assignVariant();
            } catch (e) {
                variant = 'A';
            }
            if (variant === 'B') {
                document.documentElement.classList.add('ab-variant-b');
            }
            window.dataLayer.push({ ab_productlist_variant: variant });
        })();

        window.dataLayer.push({
            "env": "production"
        });
                window.dataLayer.push({
            "deviceType": "default"
        });
            </script>

