    <script src='https://amnibus.com/js/app.js'></script>
    <script src="https://amnibus.com/js/ec/show-custom-error.js"></script>
        
    <script src="https://amnibus.com/js/ec/input-quantity.js"></script>

    <script>
        // jQuery 未読込時は $ が undefined で ReferenceError になるためスキップする
        if (typeof $ !== 'undefined') {
            $('#cart_submit').on('click', async () => {
                $('#productDetailErrorMessage').hide();

                const productClassId = $('input[name="productClassId"]:checked').val();
                const quantity = $('#quantity').val();
                const price = $('input[name="productClassId"]:checked').data('price');
                const priceIncTax = $('input[name="productClassId"]:checked').data('priceIncTax');
                const data = {
                    productClassId,
                    quantity,
                    price,
                }

                const token = (await (await fetch('/cart/token')).json()).token;

                fetch('/cart', {
                    method: 'POST',
                    headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': token,
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify(data),
                }).then(response => {
                    if (!response.ok) {
                        return response.json().then(err => Promise.reject(err))
                    }
                    return response.json()
                }).then(data => {
                    const count = data.count
                    $('#badgeCount').hide().text(count).fadeIn(1000)
                    window.dataLayer = window.dataLayer || [];
                    window.dataLayer.push({ ecommerce: null });
                    window.dataLayer.push({
                        event: "add_to_cart",
                        ecommerce: {
                            currency: "JPY",
                            value: Number(priceIncTax) * Number(quantity),
                            items: [{
                                item_id: "118131",
                                item_name: "\u30ce\u30fc\u30b2\u30fc\u30e0\u30fb\u30ce\u30fc\u30e9\u30a4\u30d5 \u30bc\u30ed\/\u63cf\u304d\u4e0b\u308d\u3057 \u30ae\u30e3\u30eb\u5236\u670dver. \u30c8\u30ec\u30fc\u30c7\u30a3\u30f3\u30b0\u30b0\u30ea\u30c3\u30bf\u30fc\u7f36\u30d0\u30c3\u30b8",
                                price: Number(priceIncTax),
                                quantity: Number(quantity)
                            }]
                        }
                    });
                    window.dispatchEvent(new CustomEvent('cart:added', { detail: data }));
                }).catch(error => {
                    $('#productDetailErrorMessage p').text(error.message);
                    $('#productDetailErrorMessage').show();
                });
            });

            $('#quantity').on('blur', function () {
                const maxQuantity = 9999
                const value = $(this).val()
                if (value >= maxQuantity) {
                    $(this).val(maxQuantity)
                    $('.addQuantity').addClass('disabled')
                    $('.subQuantity').removeClass('disabled')
                } else if (value <= 1) {
                    $(this).val(1)
                    $('.addQuantity').removeClass('disabled')
                    $('.subQuantity').addClass('disabled')
                } else {
                    $('.addQuantity').removeClass('disabled')
                    $('.subQuantity').removeClass('disabled')
                }
            })
        } else {
            console.warn('[product] jQuery 未読込のためカート投入を無効化');
        }
    </script>

    
    <script
        src="https://scaleflex.cloudimg.io/v7/plugins/js-cloudimage-360-view/latest/js-cloudimage-360-view.min.js?func=proxy">
    </script>

    <script src="/js/amnibus/details/index.js?id=a8941878f2a16273f795b1473251a174"></script>
    <script src="https://amnibus.com/js/dayjs.js"></script>
    <script>
        (function () {
            // jQuery 未読込環境では ReferenceError になるため以降をスキップする
            if (typeof $ === 'undefined') {
                return;
            }

            let isNotice = false;
            let noticeHeight = 0;

            // お知らせを取得、DOMに追加
            fetch('/news_header', {
                method: 'GET'
            }).then(response => {
                if (!response.ok) {
                    return response.json().then(err => Promise.reject(err))
                }
                return response.json()
            }).then(data => {
                if (data.data.length > 0) {
                    isNotice = true;
                    $('.headerNotice').show();
                    $('#headerNoticeContainer').append(
                        data.data.map(x =>
                            `<a href="/news/detail/${x.id}" class="linkText">
                                <img
                                    src="https://amnibus.com/images/material_icons/arrow_forward.svg"
                                    class="drawHeader__news--image icon iconWhite"
                                />
                                <span class="drawHeader__news--title">
                                    ${x.news_title}(${dayjs(x.news_date).format('M/D')})
                                </span>
                            </a>`
                        )
                    )

                    // DOMの更新後に再計算
                    adjustMargin();
                    noticeHeight = $('.headerNotice').outerHeight();
                }
            }).catch(error => {
                console.error(error);
            });

            // ヘッダー分全体を下げる
            function adjustMargin() {
                const $header = $('#header__contents');
                let headerHeight = $header.outerHeight();
                const hasBanner = $('.p-headerSuperviseAccount').length > 0;
                if (isNotice || hasBanner) {
                    // お知らせまたは監修バナーがある場合はそれ自体で全体を下げるので0
                    headerHeight = 0;
                }
                $('#main').css('margin-top', headerHeight + 'px');
            }

            adjustMargin();
            $(window).on('resize', adjustMargin);
        })();
    </script>
    </body>

<script>
    // 決済画面からレジに戻った時にオーバーレイを非表示にする
    // jQuery 未読込時でも動作するよう vanilla JS で実装する
    function hideOverlay() {
        const overlay = document.getElementById('overlay');
        if (overlay) {
            overlay.style.display = 'none';
        }
    }

    window.addEventListener('pageshow', hideOverlay);

    // safari対応
    document.addEventListener('visibilitychange', hideOverlay);
</script>

</html>
