        slidesToScroll: 6,
                prevArrow: '<p class="slick-prev"><img src="https://2xww3qjd.user.webaccel.jp/template/default/img/common/slick-prev.webp" alt="前へ"></p>',
                nextArrow: '<p class="slick-next"><img src="https://2xww3qjd.user.webaccel.jp/template/default/img/common/slick-next.webp" alt="次へ"></p>',
        responsive: [
            {
                breakpoint: 768,
                settings: {
                    slidesToShow: 3,
                    slidesToScroll: 3
                }
            }
        ]
    });

    $('.history_products_inner').slick({
        arrows: true,
        dots: false,
                infinite: false,
        speed: 300,
        slidesToShow: 8,
        slidesToScroll: 8,
                prevArrow: '<p class="slick-prev"><img src="https://2xww3qjd.user.webaccel.jp/template/default/img/common/slick-prev.webp" alt="前へ"></p>',
                nextArrow: '<p class="slick-next"><img src="https://2xww3qjd.user.webaccel.jp/template/default/img/common/slick-next.webp" alt="次へ"></p>',
        responsive: [
            {
                breakpoint: 768,
                settings: {
                    slidesToShow: 4,
                    slidesToScroll: 4
                }
            }
        ]
    });

    // bfcache無効化
    $(window).bind('pageshow', function(event) {
        if (event.originalEvent.persisted) {
            location.reload(true);
        }
    });

    var cartSubmitting = false;
    $('#add-cart-new').on('touchend click', function (e) {
        e.preventDefault();

        if (cartSubmitting) {
            return false;
        }
        cartSubmitting = true;

        var $btn = $(this);

        $('#mode').val('add_cart');

        // まずネイティブsubmitを実行
        document.getElementById('form1').submit();

        // submit開始後に二重送信防止をかける
        setTimeout(function () {
            $btn.prop('disabled', true);

            if ($('.prevention-masked').length === 0) {
                $('body').append('<div class="prevention-masked"></div>');
            }
        }, 0);

        return false;
    });

    $('#favorite').click(function() {
        $('#mode').val('add_favorite');

        if ($(this).prop('disabled')) {
            return false;
        }

        $(this).prop('disabled', true);

        if ($('.prevention-masked').length === 0) {
            $('body').append('<div class="prevention-masked"></div>');
        }
        
        $('#form1').submit();
    });

});

</script>
<style>
@media only screen and (max-width: 767px) {
    .btn-cart {
        width: 100%;
        text-align: center;
    }
}

.btn-cart {
    height: 45px;
    margin: 15px 0 0;
    line-height: 45px;
    width: 15em;
    vertical-align: middle;
    padding-top: 0;
    padding-bottom: 0;
    font-size: 1.6rem;
    font-weight: bold;
}

.btn-primary-cart {
    color: #fff;
    background-color: #ee3503;
    border-color: #ee3503;
}
</style>
</body>
</html>
