							<section>
								
								<div class="item_spec" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
									
									<h3>商品スペック</h3>
									
									<dl>
										<dt>メーカー</dt><dd class="maker"><a href="/maker/bushiroad">ブシロードクリエイティブ（BUSHIROAD CREATIVE）</a></dd>
																														<dt>作品名</dt><dd>進撃の巨人</dd>
																				<dt>シリーズ</dt><dd>PalVerse</dd>
																				<dt>サイズ</dt><dd>商品サイズ 本体:全高約90mm</dd>
																				<dt>素材</dt><dd>製品素材 本体：PVC</dd>
